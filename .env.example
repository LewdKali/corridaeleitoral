# Gateway recomendado: Asaas (PIX nativo com QR na página)
# https://www.asaas.com → Integrações → API Key
ASAAS_API_KEY=
# true = sandbox | false = produção
ASAAS_SANDBOX=false
# Token do webhook (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# CPF/CNPJ do dono da conta (só números). Ex: 12345678901
ASAAS_CUSTOMER_CPF=

NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app

# Webhook Asaas (painel Asaas → Integrações → Webhooks):
# https://seu-app.vercel.app/api/webhook
# Eventos: PAYMENT_RECEIVED, PAYMENT_CONFIRMED

# Placar persistente (obrigatório na Vercel):
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional (legado). Se ASAAS_API_KEY existir, Asaas tem prioridade.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=false
MERCADOPAGO_WEBHOOK_URL=
